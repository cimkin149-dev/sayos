<?xml version="1.0"?>
<labwc_config>
  <theme>
    <name>SayMy</name>
    <cornerRadius>10</cornerRadius>
    <font place="" name="Inter" size="10"/>
  </theme>
  <keyboard>
    <default />
    <!-- The Say Bar: the face of SayMy OS -->
    <keybind key="W-space"><action name="Execute" command="saymy-say"/></keybind>
    <keybind key="A-space"><action name="Execute" command="saymy-say"/></keybind>
    <keybind key="W-comma"><action name="Execute" command="saymy-settings"/></keybind>
    <keybind key="W-a"><action name="Execute" command="fuzzel"/></keybind>
    <keybind key="W-Return"><action name="Execute" command="foot"/></keybind>
    <keybind key="W-e"><action name="Execute" command="pcmanfm"/></keybind>
    <keybind key="W-b"><action name="Execute" command="firefox-esr"/></keybind>
    <keybind key="W-l"><action name="Execute" command="saymy-lock"/></keybind>
    <keybind key="Print"><action name="Execute" command="saymy-screenshot"/></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"/></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"/></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"/></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="brightnessctl set 5%+"/></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="brightnessctl set 5%-"/></keybind>
  </keyboard>
  <mouse><default /></mouse>
</labwc_config>

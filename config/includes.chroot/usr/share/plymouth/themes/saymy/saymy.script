# SayMy boot splash: logo breathes gently, a sunrise-orange bar fills with boot progress.
Window.SetBackgroundTopColor(0.047, 0.102, 0.165);
Window.SetBackgroundBottomColor(0.020, 0.043, 0.086);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = screen_w / 2 - logo.image.GetWidth() / 2;
logo.y = screen_h / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 10);

track.image = Image("bar-bg.png");
track.sprite = Sprite(track.image);
track.x = screen_w / 2 - track.image.GetWidth() / 2;
track.y = logo.y + logo.image.GetHeight() + 48;
track.sprite.SetPosition(track.x, track.y, 5);

bar.image = Image("bar.png");
bar.sprite = Sprite();
bar.sprite.SetPosition(track.x, track.y, 6);

tick = 0;
fun refresh_callback ()
{
  tick++;
  logo.sprite.SetOpacity(0.82 + 0.18 * Math.Sin(tick / 18));
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback (duration, progress)
{
  width = Math.Int(bar.image.GetWidth() * progress);
  if (width < 2) width = 2;
  bar.sprite.SetImage(bar.image.Scale(width, bar.image.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_callback);

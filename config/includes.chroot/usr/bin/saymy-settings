#!/usr/bin/env python3
"""SayMy Settings: network, display, sound, power, appearance, language, data and money, about.

Every control calls a real system tool through saymy_settings_backend. Run with --demo to see
sample data on a machine without Wi-Fi or a battery.
"""
import os
import sys
import threading

if "--demo" in sys.argv:
    os.environ["SAYMY_DEMO"] = "1"
sys.path.insert(0, os.environ.get("SAYMY_LIB", "/usr/lib/saymy"))

import gi
gi.require_version("Gtk", "4.0")
from gi.repository import GLib, Gtk, Gdk  # noqa: E402

import saymy_i18n as i18n              # noqa: E402
import saymy_settings_backend as be    # noqa: E402

from saymy_ui import CSS, css_for, bg, debounced, label, row, switch, scale, page  # noqa: E402,F401


class Settings(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Settings")
        self.set_default_size(960, 620)
        self.accent = be.load_appearance().get("accent", be.DEFAULT_ACCENT)
        self.provider = Gtk.CssProvider()
        self.apply_css()
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self.provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        side.add_css_class("side")
        side.set_size_request(230, -1)
        side.append(label("SayMy Settings", "brand"))
        self.list = Gtk.ListBox()
        self.list.set_vexpand(True)
        side.append(self.list)
        self.stack = Gtk.Stack()
        self.stack.set_hexpand(True)
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.panels = [("Network", self.network), ("Display", self.display), ("Sound", self.sound),
                       ("Power", self.power), ("Appearance", self.appearance), ("Language", self.language),
                       ("Data & Money", self.data), ("Users", self.users), ("Updates", self.updates), ("About", self.about)]
        for name, build in self.panels:
            self.list.append(Gtk.Label(label=name, xalign=0))
            self.stack.add_named(build(), name)
        self.list.connect("row-selected", lambda lb, r: r and self.stack.set_visible_child_name(self.panels[r.get_index()][0]))
        start = os.environ.get("SAYMY_START_PANEL", "Network")
        idx = next((i for i, p in enumerate(self.panels) if p[0] == start), 0)
        self.list.select_row(self.list.get_row_at_index(idx))
        root.append(side)
        root.append(self.stack)
        self.set_child(root)

    def apply_css(self):
        css = css_for(self.accent)
        if hasattr(self.provider, "load_from_string"):
            self.provider.load_from_string(css)
        else:
            self.provider.load_from_data(css.encode())

    # ---------------------------------------------------------- Network
    def network(self):
        outer, box = page("Network")
        self.wifi_status = label("", "dim")
        box.append(row("Wi-Fi", "Turn the radio on or off", switch(be.wifi_enabled(), self.wifi_toggle)))
        head = Gtk.Box(spacing=10)
        head.append(label("Available networks", "rt"))
        refresh = Gtk.Button(label="Refresh")
        refresh.connect("clicked", lambda b: self.wifi_refresh())
        head.append(refresh)
        head.set_margin_bottom(8)
        box.append(head)
        self.wifi_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(self.wifi_box)
        box.append(self.wifi_status)
        self.wifi_refresh()
        return outer

    def wifi_toggle(self, on):
        bg(lambda: be.wifi_set(on), lambda ok: self.wifi_refresh())

    def wifi_refresh(self):
        self.wifi_status.set_text("Looking for networks…")
        bg(be.wifi_list, self.wifi_show)

    def wifi_show(self, nets):
        while (c := self.wifi_box.get_first_child()):
            self.wifi_box.remove(c)
        self.wifi_status.set_text("" if nets else "No networks found. Wi-Fi may be off or unavailable on this computer.")
        for n in nets:
            sub = ("Connected · " if n["connected"] else "") + ("Secured" if n["secure"] else "Open") + f" · {n['signal']}%"
            btn = Gtk.Button(label="Connected" if n["connected"] else "Connect")
            btn.set_sensitive(not n["connected"])
            if not n["connected"]:
                btn.add_css_class("accent")
                btn.connect("clicked", lambda b, net=n: self.wifi_connect(net))
            self.wifi_box.append(row(n["ssid"], sub, btn))

    def wifi_connect(self, net):
        if not net["secure"]:
            return self.wifi_do(net["ssid"], "")
        win = Gtk.Window(title=f"Connect to {net['ssid']}", transient_for=self, modal=True)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for m in ("top", "bottom", "start", "end"):
            getattr(box, f"set_margin_{m}")(22)
        box.append(label(f"Password for {net['ssid']}", "rt"))
        entry = Gtk.PasswordEntry()
        entry.set_show_peek_icon(True)
        entry.set_size_request(320, -1)
        box.append(entry)
        buttons = Gtk.Box(spacing=10)
        cancel, ok = Gtk.Button(label="Cancel"), Gtk.Button(label="Connect")
        ok.add_css_class("accent")
        cancel.connect("clicked", lambda b: win.close())
        ok.connect("clicked", lambda b: (win.close(), self.wifi_do(net["ssid"], entry.get_text())))
        entry.connect("activate", lambda e: ok.emit("clicked"))
        buttons.append(cancel)
        buttons.append(ok)
        box.append(buttons)
        win.set_child(box)
        win.present()

    def wifi_do(self, ssid, password):
        self.wifi_status.set_text(f"Connecting to {ssid}…")
        def done(res):
            self.wifi_status.set_text(f"Connected to {ssid}." if res[0] else "Could not connect. Check the password and try again.")
            self.wifi_refresh()
        bg(lambda: be.wifi_connect(ssid, password), done)

    # ---------------------------------------------------------- Display
    def display(self):
        outer, box = page("Display")
        b = be.brightness_get()
        if b is None:
            box.append(row("Brightness", "No adjustable screen brightness was found on this computer."))
        else:
            box.append(row("Brightness", "Lower brightness stretches battery life during a power cut",
                           scale(b, lambda v: bg(lambda: be.brightness_set(v), lambda r: None))))
        cfg = be.load_display()
        box.append(row("Night light", "Warms the screen in the evening, easier on the eyes",
                       switch(cfg["night"], lambda on: bg(lambda: be.night_set(on), lambda r: None))))
        seg = Gtk.Box(spacing=6)
        first = None
        for name, kelvin in be.WARMTH.items():
            tb = Gtk.ToggleButton(label=name)
            if first is None:
                first = tb
            else:
                tb.set_group(first)
            tb.set_active(kelvin == cfg["warmth"])
            tb.connect("toggled", lambda w, k=kelvin: w.get_active() and bg(lambda: be.night_set(warmth=k), lambda r: None))
            seg.append(tb)
        box.append(row("Warmth", None, seg))
        times = Gtk.Box(spacing=8)
        for key in ("start", "end"):
            e = Gtk.Entry()
            e.set_max_length(5)
            e.set_size_request(84, -1)
            e.set_text(cfg[key])
            apply = debounced(lambda k, v: be.valid_time(v) and bg(lambda: be.night_set(**{k: v}), lambda r: None), 600)
            e.connect("changed", lambda w, k=key: apply(k, w.get_text()))
            times.append(label("From" if key == "start" else "to", "dim"))
            times.append(e)
        box.append(row("Night light schedule", "Use 24 hour times like 19:00", times))
        options = [("Never", 0), ("5 minutes", 5), ("10 minutes", 10), ("15 minutes", 15), ("30 minutes", 30)]
        dd = Gtk.DropDown.new_from_strings([o[0] for o in options])
        dd.set_selected(next((i for i, o in enumerate(options) if o[1] == cfg["lock_minutes"]), 2))
        dd.connect("notify::selected", lambda w, _p: be.lock_set(options[w.get_selected()][1]))
        box.append(row("Lock the screen after", "Then the computer sleeps 5 minutes later to save power", dd))
        return outer

    # ---------------------------------------------------------- Sound
    def sound(self):
        outer, box = page("Sound")
        vol, muted = be.volume_get()
        if vol is None:
            box.append(row("Volume", "The audio service is not running on this computer."))
        else:
            box.append(row("Volume", None, scale(min(vol, 100), lambda v: bg(lambda: be.volume_set(v), lambda r: None))))
            box.append(row("Mute", None, switch(muted, lambda on: bg(lambda: be.mute_set(on), lambda r: None))))
        return outer

    # ---------------------------------------------------------- Power
    def power(self):
        outer, box = page("Power")
        info = be.power_summary()
        st = info["state"]
        if st["battery_pct"] is None:
            box.append(row("Battery", "No battery found. This computer runs on mains power."))
        else:
            src = "On mains power" if st["ac"] else "Running on battery"
            box.append(row("Battery", f"{src} · {st['battery_status'] or ''}", label(f"{st['battery_pct']}%", "rt")))
        prof = be.profile_get()
        seg = Gtk.Box(spacing=6)
        first = None
        for p in be.PROFILES:
            b = Gtk.ToggleButton(label=p.replace("-", " ").title())
            if first is None:
                first = b
            else:
                b.set_group(first)
            b.set_active(p == prof)
            b.connect("toggled", lambda w, name=p: w.get_active() and bg(lambda: be.profile_set(name), lambda r: None))
            seg.append(b)
        box.append(row("Power mode", "Power saver slows the processor to save battery" if prof else "Power profiles are not available on this computer.", seg if prof else None))
        ok, out = be.run(["systemctl", "--user", "is-active", "saymy-power"])
        active = (out == "active") or be.demo()
        g = label("Active" if active else "Not running", "good" if active else "bad")
        box.append(row("Power-cut guard", "Protects your session, dims the screen, and warns you when mains power drops", g))
        box.append(row("Power Diary", "Last 30 days", label(f"{info['cuts']} cuts · {info['hours']} h without mains", "rt")))
        return outer

    # ---------------------------------------------------------- Appearance
    def appearance(self):
        outer, box = page("Appearance")
        cfg = be.load_appearance()
        sw_box = Gtk.Box(spacing=10)
        self.swatches = {}
        for name, hexv in be.ACCENTS.items():
            b = Gtk.Button()
            b.add_css_class("swatch")
            b.add_css_class(f"sw-{name}")
            b.set_tooltip_text(name)
            if hexv.upper() == self.accent.upper():
                b.add_css_class("sel")
            b.connect("clicked", lambda w, h=hexv: self.set_accent(h))
            self.swatches[hexv] = b
            sw_box.append(b)
        box.append(row("Accent colour", "Changes the panel, launcher, notifications, window borders and apps", sw_box))
        box.append(row("Follow the sky", "The accent shifts gently from sunrise to night, with the wallpaper",
                       switch(bool(cfg.get("follow_sky")), self.set_follow)))
        self.appearance_status = label("", "dim")
        box.append(self.appearance_status)
        return outer

    def set_accent(self, hexv):
        def done(changed):
            self.accent = hexv
            self.apply_css()
            for h, b in self.swatches.items():
                (b.add_css_class if h.upper() == hexv.upper() else b.remove_css_class)("sel")
            self.appearance_status.set_text(f"Updated {len(changed)} files. Open apps pick up the new colour when restarted.")
        cfg = be.load_appearance()
        cfg["follow_sky"] = False
        be.save_appearance(cfg)
        bg(lambda: be.apply_accent(hexv), done)

    def set_follow(self, on):
        cfg = be.load_appearance()
        cfg["follow_sky"] = on
        be.save_appearance(cfg)

    # ---------------------------------------------------------- Language
    def language(self):
        outer, box = page("Language")
        langs = i18n.available_languages()
        current = i18n.current_language()
        for code, name in langs.items():
            b = Gtk.Button(label="Current" if code == current else "Use")
            if code == current:
                b.set_sensitive(False)
            else:
                b.add_css_class("accent")
                b.connect("clicked", lambda w, c=code: self.set_language(c))
            box.append(row(name, "Needs a native speaker to translate" if code == "lg" else None, b))
        box.append(label("Applies to SayMy tools: the Say Bar, notifications and the Power Diary. "
                         "System-wide language follows in 0.2. Missing words fall back to English.", "dim", wrap=True))
        return outer

    def set_language(self, code):
        d = i18n.config_dir()
        d.mkdir(parents=True, exist_ok=True)
        (d / "lang").write_text(code)
        self.stack.remove(self.stack.get_child_by_name("Language"))
        self.stack.add_named(self.language(), "Language")
        self.stack.set_visible_child_name("Language")

    # ---------------------------------------------------------- Data & Money
    def data(self):
        import saymy_data
        outer, box = page("Data & Money")
        ledger = saymy_data._load(saymy_data.ledger_path(), {"days": {}})
        t = saymy_data.totals(ledger)
        for title, key in (("Today", "today"), ("Last 7 days", "week"), ("This month", "month")):
            cost = saymy_data.cost_text(t[key])
            box.append(row(title, None, label(saymy_data.human(t[key]) + (f" · {cost}" if cost else ""), "rt")))
        cfg = saymy_data.price()
        price = Gtk.Entry(placeholder_text="5000")
        price.set_size_request(110, -1)
        price.set_text(str(cfg.get("price_per_gb") or ""))
        cur = Gtk.Entry(placeholder_text="UGX")
        cur.set_max_length(4)
        cur.set_text(cfg.get("currency", ""))
        cur.set_size_request(90, -1)
        pair = Gtk.Box(spacing=8)
        pair.append(price)
        pair.append(cur)
        box.append(row("What does one gigabyte cost?", "Nothing is assumed. Enter your own price and currency.", pair))
        status = label("", "dim")
        save = Gtk.Button(label="Save")
        save.add_css_class("accent")
        save.set_halign(Gtk.Align.START)

        def do_save(_b):
            try:
                saymy_data.set_price(float(price.get_text()), cur.get_text() or "")
                status.set_text("Saved. The panel counter now shows your spending.")
            except ValueError:
                status.set_text("Please enter the price as a number.")
        save.connect("clicked", do_save)
        box.append(save)
        box.append(status)
        return outer

    # ---------------------------------------------------------- shared dialogs
    def rebuild(self, name):
        build = dict(self.panels)[name]
        self.stack.remove(self.stack.get_child_by_name(name))
        self.stack.add_named(build(), name)
        self.stack.set_visible_child_name(name)

    def form(self, title, fields, ok_label, on_ok):
        """fields: [(key, label, 'text'|'password'|'switch')]. on_ok(values) returns an error message or None."""
        win = Gtk.Window(title=title, transient_for=self, modal=True)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for m in ("top", "bottom", "start", "end"):
            getattr(box, f"set_margin_{m}")(24)
        box.append(label(title, "rt"))
        widgets = {}
        for key, text, kind in fields:
            box.append(label(text, "dim"))
            if kind == "password":
                w = Gtk.PasswordEntry()
                w.set_show_peek_icon(True)
            elif kind == "switch":
                w = Gtk.Switch()
                w.set_halign(Gtk.Align.START)
            else:
                w = Gtk.Entry()
            w.set_size_request(340, -1) if kind != "switch" else None
            widgets[key] = w
            box.append(w)
        err = label("", "bad", wrap=True)
        box.append(err)
        buttons = Gtk.Box(spacing=10)
        cancel, ok = Gtk.Button(label="Cancel"), Gtk.Button(label=ok_label)
        ok.add_css_class("accent")
        cancel.connect("clicked", lambda b: win.close())

        def go(_b):
            values = {k: (w.get_active() if isinstance(w, Gtk.Switch) else w.get_text()) for k, w in widgets.items()}
            problem = on_ok(values)
            if problem:
                err.set_text(problem)
            else:
                win.close()
        ok.connect("clicked", go)
        buttons.append(cancel)
        buttons.append(ok)
        box.append(buttons)
        win.set_child(box)
        win.present()

    def confirm(self, text, yes_label, on_yes):
        win = Gtk.Window(title="Are you sure?", transient_for=self, modal=True)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        for m in ("top", "bottom", "start", "end"):
            getattr(box, f"set_margin_{m}")(24)
        box.append(label(text, "rt", wrap=True))
        row_ = Gtk.Box(spacing=10)
        no, yes = Gtk.Button(label="Cancel"), Gtk.Button(label=yes_label)
        yes.add_css_class("accent")
        no.connect("clicked", lambda b: win.close())
        yes.connect("clicked", lambda b: (win.close(), on_yes()))
        row_.append(no)
        row_.append(yes)
        box.append(row_)
        win.set_child(box)
        win.present()

    def pick_folder(self, on_pick):
        dialog = Gtk.FileDialog()
        def done(d, result):
            try:
                f = d.select_folder_finish(result)
            except GLib.Error:
                return
            on_pick(f.get_path())
        dialog.select_folder(self, None, done)

    # ---------------------------------------------------------- Users
    def users(self):
        import saymy_system as sysm
        outer, box = page("Users")
        people = sysm.demo_users() if be.demo() else sysm.list_users()
        me = "steven" if be.demo() else sysm.current_user()
        status = self.users_status = label("", "dim", wrap=True)

        def after(res, ok_text):
            status.set_text(ok_text if res[0] else "That did not work: " + (res[1].strip().splitlines() or ["unknown error"])[-1])
            self.rebuild("Users")
            self.users_status.set_text(status.get_text())

        for u in people:
            controls = Gtk.Box(spacing=6)
            pw = Gtk.Button(label="Password")
            pw.connect("clicked", lambda b, n=u["name"]: self.form(f"New password for {n}", [("a", "New password", "password"), ("b", "Type it again", "password")], "Change",
                       lambda v, n=n: ("The two passwords are different." if v["a"] != v["b"] else None) or ("Use at least 6 characters." if not sysm.valid_password(v["a"]) else
                                                                                                               bg(lambda: sysm.set_password(n, v["a"]), lambda r: after(r, f"Password changed for {n}.")))))
            controls.append(pw)
            if u["name"] != me:
                adm = Gtk.Button(label="Remove admin" if u["admin"] else "Make admin")
                adm.connect("clicked", lambda b, n=u["name"], a=u["admin"]: bg(lambda: sysm.set_admin(n, not a), lambda r: after(r, "Updated.")))
                rem = Gtk.Button(label="Remove")
                rem.connect("clicked", lambda b, n=u["name"]: self.confirm(f"Remove {n} and all their files? This cannot be undone.", "Remove",
                            lambda: bg(lambda: sysm.remove_user(n), lambda r: after(r, f"{n} was removed."))))
                controls.append(adm)
                controls.append(rem)
            who = (u["fullname"] or u["name"]) + (" (you)" if u["name"] == me else "")
            box.append(row(who, f"{u['name']} · " + ("Administrator" if u["admin"] else "Standard"), controls))
        add = Gtk.Button(label="Add a person")
        add.add_css_class("accent")
        add.set_halign(Gtk.Align.START)

        def add_ok(v):
            if not v["name"].strip():
                return "Please enter a name."
            if not sysm.valid_username(v["user"]):
                return "The user name needs 1 to 31 lowercase letters, digits, - or _, starting with a letter."
            if v["pw"] != v["pw2"]:
                return "The two passwords are different."
            if not sysm.valid_password(v["pw"]):
                return "Use at least 6 characters."
            bg(lambda: sysm.add_user(v["user"], v["name"], v["pw"], v["admin"]), lambda r: after(r, f"{v['name']} was added."))
        add.connect("clicked", lambda b: self.form("Add a person", [("name", "Full name", "text"), ("user", "User name (lowercase, no spaces)", "text"),
                    ("pw", "Password", "password"), ("pw2", "Type the password again", "password"), ("admin", "Administrator", "switch")], "Add", add_ok))
        box.append(add)
        box.append(status)
        box.append(label("Changes ask for your password. Guests, shared-computer mode and per-person Spaces come in 0.3.", "dim", wrap=True))
        return outer

    # ---------------------------------------------------------- Updates
    def updates(self):
        import saymy_system as sysm
        outer, box = page("Updates")
        self.up_status = label("Checking for updates…", "dim", wrap=True)
        box.append(self.up_status)
        self.up_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        btns = Gtk.Box(spacing=10)
        check = Gtk.Button(label="Check for updates")
        check.connect("clicked", lambda b: self.up_check())
        self.install_btn = Gtk.Button(label="Install updates")
        self.install_btn.add_css_class("accent")
        self.install_btn.set_sensitive(False)
        self.install_btn.connect("clicked", lambda b: self.up_install())
        btns.append(check)
        btns.append(self.install_btn)
        box.append(btns)
        box.append(self.up_list)
        self.log = Gtk.TextView(editable=False, monospace=True, cursor_visible=False)
        self.log_scroll = Gtk.ScrolledWindow()
        self.log_scroll.set_min_content_height(160)
        self.log_scroll.set_child(self.log)
        self.log_scroll.set_visible(False)
        box.append(self.log_scroll)
        off_title = label("Offline updates (USB or school network)", "rt")
        off_title.set_margin_top(20)
        box.append(off_title)
        box.append(label("On a computer with internet, prepare a bundle. On other computers, install it with no internet. "
                         "Only install bundles you made yourself or got from someone you trust: they install software as administrator.", "dim", wrap=True))
        off = Gtk.Box(spacing=10)
        prep = Gtk.Button(label="Prepare a bundle…")
        prep.connect("clicked", lambda b: self.pick_folder(self.up_prepare))
        inst = Gtk.Button(label="Install from a bundle…")
        inst.connect("clicked", lambda b: self.pick_folder(self.up_from_bundle))
        off.append(prep)
        off.append(inst)
        box.append(off)
        self.up_refresh()
        return outer

    def up_refresh(self):
        import saymy_system as sysm
        bg(lambda: (sysm.check_updates(), sysm.update_blockers(), sysm.undo_list()), self.up_show)

    def up_show(self, data):
        import saymy_system as sysm
        ups, blockers, history = data
        while (c := self.up_list.get_first_child()):
            self.up_list.remove(c)
        age = sysm.lists_age_hours()
        when = "" if age is None else f" Package lists were refreshed {age} hours ago." if age else " Package lists are fresh."
        sec = sum(u["security"] for u in ups)
        if blockers:
            self.up_status.set_text("Updates cannot start yet. " + " ".join(blockers))
        elif not ups:
            self.up_status.set_text("Your computer is up to date." + when)
        else:
            self.up_status.set_text(f"{len(ups)} updates available" + (f", {sec} for security." if sec else ".") + when +
                                    " Before installing, SayMy keeps the old versions so you can undo.")
        self.install_btn.set_sensitive(bool(ups) and not blockers)
        for u in ups[:8]:
            self.up_list.append(row(u["name"], f"{u['old']} → {u['new']}", label("Security", "bad") if u["security"] else label("", "dim")))
        if len(ups) > 8:
            self.up_list.append(label(f"…and {len(ups) - 8} more", "dim"))
        if history:
            head = label("Recent updates: you can undo them", "rt")
            head.set_margin_top(18)
            head.set_margin_bottom(8)
            self.up_list.append(head)
        for e in history:
            broke = bool(e["new_failures"]) or not e["ok"]
            sub = ("Something failed afterwards: " + ", ".join(e["new_failures"]) if e["new_failures"]
                   else "The update did not finish cleanly" if not e["ok"] else "Everything stayed healthy")
            sub += f" · {e['count']} packages kept" + (" · includes a kernel; the old one stays in the boot menu" if e["kernel"] else "")
            if e["undoable"]:
                b = Gtk.Button(label="Undo this update")
                if broke:
                    b.add_css_class("accent")
                b.connect("clicked", lambda w, i=e["id"]: self.up_undo(i))
            else:
                b = label("Undone", "dim")
            self.up_list.append(row(e["when"], sub, b))

    def up_check(self):
        import saymy_system as sysm
        self.up_status.set_text("Refreshing the list. This needs the internet and your password…")
        bg(sysm.update_lists, lambda r: (self.up_refresh(), r[0] or self.up_status.set_text("Could not refresh. Check your internet connection.")))

    def append_log(self, line):
        buf = self.log.get_buffer()
        buf.insert(buf.get_end_iter(), line + "\n")
        adj = self.log_scroll.get_vadjustment()
        adj.set_value(adj.get_upper())

    def run_safe(self, start_text, fn, describe):
        self.install_btn.set_sensitive(False)
        self.log.get_buffer().set_text("")
        self.log_scroll.set_visible(True)
        self.up_status.set_text(start_text)
        def work():
            ok, res = fn(lambda ln: GLib.idle_add(self.append_log, ln))
            GLib.idle_add(lambda: (self.up_status.set_text(describe(ok, res)), self.up_refresh()))
        threading.Thread(target=work, daemon=True).start()

    def up_install(self):
        import saymy_system as sysm
        def describe(ok, res):
            if res.get("stage") == "precheck":
                return "Not started: " + " ".join(res.get("problems", []))
            if ok and res.get("new_failures"):
                return "Updated, but something failed afterwards. You can undo it below."
            if ok:
                return "Updated. Everything is healthy." + (" Restart to finish the kernel update." if res.get("kernel") else "")
            return "The update did not finish cleanly. You can undo it below."
        self.run_safe("Installing updates safely. Old versions are kept first. Keep the computer on and plugged in.", lambda cb: sysm.safe_apply(cb), describe)

    def up_undo(self, txn):
        import saymy_system as sysm
        self.confirm("Undo this update? The previous versions come back, and those packages stay held back until you install updates again.", "Undo",
                     lambda: self.run_safe("Restoring the previous versions…", lambda cb: sysm.safe_undo(txn, cb),
                                           lambda ok, res: "Restored the previous versions." + (" Restart to use the previous kernel." if ok and res.get("kernel") else "") if ok else res.get("error", "Could not undo this update.")))

    def up_prepare(self, folder):
        import saymy_system as sysm
        self.up_status.set_text("Downloading updates into the bundle. This needs the internet and your password…")
        bg(lambda: sysm.make_bundle(folder), lambda r: self.up_status.set_text(r[1] if r[0] else "Could not prepare the bundle: " + r[1][-200:]))

    def up_from_bundle(self, folder):
        import saymy_system as sysm
        problems = sysm.verify_bundle(folder)
        if problems:
            return self.up_status.set_text("This bundle cannot be installed: " + "; ".join(problems))
        n = len(sysm.json.loads((sysm.Path(folder) / "manifest.json").read_text())["packages"])
        self.confirm(f"Install {n} packages from this bundle as administrator? Old versions are kept so you can undo.", "Install",
                     lambda: self.run_safe("Installing the bundle safely…", lambda cb: sysm.safe_apply(cb, bundle=folder),
                                           lambda ok, res: "Bundle installed. You can undo it below." if ok else "Not installed. " + " ".join(res.get("problems", [])) or "The bundle did not install."))

    # ---------------------------------------------------------- About
    def about(self):
        outer, box = page("About")
        info = be.system_info()
        for title, key in (("System", "os"), ("Kernel", "kernel"), ("Processor", "cpu"), ("Memory", "ram"), ("Storage", "disk")):
            box.append(row(title, None, label(info[key] or "Unknown", "rt")))
        box.append(label("SayMy OS · Born in Africa. Built for the world.", "dim"))
        return outer


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.saymy.Settings")

    def do_activate(self):
        (self.props.active_window or Settings(self)).present()


if __name__ == "__main__":
    sys.exit(App().run([a for a in sys.argv if a != "--demo"]))

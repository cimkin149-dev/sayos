{
  "name": "SayMy Design Tokens",
  "version": "0.1.0",
  "concept": "Born in Africa, built for the world. A lake-night base with a rising-sun accent.",
  "color": {
    "lake_night":   {"hex": "#0C1A2A", "role": "base background, the deep blue of Lake Victoria after dark"},
    "deep_water":   {"hex": "#14283C", "role": "panels, windows, surfaces"},
    "water_light":  {"hex": "#1E3A55", "role": "raised surfaces, hover, borders"},
    "bark_cloth":   {"hex": "#F3E9D8", "role": "primary text, warm white"},
    "mist":         {"hex": "#9FB3C8", "role": "secondary text, inactive icons"},
    "sunrise":      {"hex": "#FF8A1F", "role": "primary accent, focus, the SayMy signature"},
    "savanna_gold": {"hex": "#F5B93A", "role": "secondary accent, highlights, warnings"},
    "banana_leaf":  {"hex": "#3FA66B", "role": "success, connected, charging"},
    "lake_blue":    {"hex": "#2F8FD1", "role": "information, links, selection"},
    "hibiscus":     {"hex": "#E0445B", "role": "errors, critical battery, destructive actions"}
  },
  "type": {
    "ui": "Inter",
    "ui_fallback": "Noto Sans",
    "mono": "JetBrains Mono",
    "note": "Noto covers nearly every script, so any language added later renders without tofu boxes."
  },
  "radius": {"window": 12, "control": 8, "chip": 999},
  "time_of_day": {
    "sunrise": {"from": 5,  "to": 8,  "accent": "#FF8A1F"},
    "day":     {"from": 8,  "to": 17, "accent": "#F5B93A"},
    "dusk":    {"from": 17, "to": 20, "accent": "#FF6B3D"},
    "night":   {"from": 20, "to": 5,  "accent": "#FF8A1F"}
  }
}
